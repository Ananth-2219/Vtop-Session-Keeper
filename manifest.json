
{
  "manifest_version": 3,
  "name": "VTOP Session Keeper",
  "version": "2.0.0",
  "description": "Monitors VTOP inactivity and attempts to maintain the session.",
  "permissions": [
    "alarms",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://vtop.vit.ac.in/vtop/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://vtop.vit.ac.in/vtop/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "VTOP Session Keeper",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "vtop-session-keeper@local"
    }
  }
}
